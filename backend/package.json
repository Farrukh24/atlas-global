{
    "name": "atlas-global-logistics-api",
    "version": "1.0.0",
    "description": "Type-safe backend API for Atlas Global Logistics - Freight matching, tracking, and settlement",
    "main": "dist/server.js",
    "scripts": {
        "dev": "nodemon",
        "build": "tsc",
        "start": "node dist/server.js",
        "test": "jest",
        "test:watch": "jest --watch",
        "lint": "eslint src/**/*.ts",
        "format": "prettier --write 'src/**/*.ts'",
        "type-check": "tsc --noEmit"
    },
    "dependencies": {
        "express": "^4.18.2",
        "pg": "^8.11.3",
        "jsonwebtoken": "^9.0.2",
        "bcrypt": "^5.1.1",
        "zod": "^3.22.4",
        "helmet": "^7.1.0",
        "cors": "^2.8.5",
        "morgan": "^1.10.0",
        "dotenv": "^16.3.1",
        "envalid": "^7.3.1",
        "winston": "^3.11.0",
        "compression": "^1.7.4",
        "express-rate-limit": "^7.1.5",
        "socket.io": "^4.7.2",
        "multer": "^1.4.5-lts.1",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.0",
        "uuid": "^9.0.1"
    },
    "devDependencies": {
        "@types/express": "^4.17.20",
        "@types/node": "^20.8.10",
        "@types/pg": "^8.10.7",
        "@types/jsonwebtoken": "^9.0.5",
        "@types/bcrypt": "^5.0.1",
        "@types/cors": "^2.8.15",
        "@types/morgan": "^1.9.9",
        "@types/compression": "^1.7.5",
        "@types/multer": "^1.4.11",
        "@types/swagger-jsdoc": "^6.0.3",
        "@types/swagger-ui-express": "^4.1.6",
        "@types/uuid": "^9.0.7",
        "@typescript-eslint/eslint-plugin": "^6.9.1",
        "@typescript-eslint/parser": "^6.9.1",
        "typescript": "^5.2.2",
        "ts-node": "^10.9.1",
        "nodemon": "^3.0.1",
        "eslint": "^8.52.0",
        "prettier": "^3.0.3",
        "jest": "^29.7.0",
        "ts-jest": "^29.1.1",
        "@types/jest": "^29.5.8",
        "supertest": "^6.3.3",
        "@types/supertest": "^2.0.16"
    },
    "engines": {
        "node": ">=20.0.0"
    }
}